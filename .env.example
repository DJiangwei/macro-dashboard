# Optional data-source credentials for unattended dashboard refreshes.
# Copy to .env.local locally if needed. Never commit real keys.

# FRED API. Used by US/UK generators when available; generators can fall back
# to public fredgraph CSV for many series.
FRED_API_KEY=

# EIA Open Data API v2. Used by future energy/oil/gas adapters when a native
# country source is not better suited.
EIA_API_KEY=

# GIE AGSI+ gas storage API.
# Request access from GIE, then export this before `make build-v4`.
GIE_AGSI_API_KEY=
GIE_AGSI_BASE_URL=https://agsi.gie.eu/api

# Stooq CSV market data.
# If the generic key URL does not work for your account, paste the exact CSV
# download URL generated by Stooq after its captcha/key flow.
STOOQ_API_KEY=
STOOQ_WIG20_CSV_URL=
STOOQ_BET_CSV_URL=
