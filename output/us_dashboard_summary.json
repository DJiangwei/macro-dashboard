    {
      "section": "production_orders",
      "item_en": "ISM manufacturing/non-manufacturing, Chicago PMI, and Beige Book text",
      "item_zh": "ISM制造业/非制造业、芝加哥PMI与褐皮书文本",
      "status_en": "National ISM/PMI and Beige Book remain adapter gaps; public regional Fed survey gauges are charted separately, and industrial production now includes both YoY and MoM release-style momentum.",
      "status_zh": "全国ISM/PMI与褐皮书仍是adapter缺口；公开地区联储调查已单独绘图，工业生产也已同时提供同比和发布式环比动能。"
    },
    {
      "section": "consumer",
      "item_en": "Conference Board confidence, Redbook, ICSC/UBS, ABC Consumer Comfort, stale OECD consumer-confidence mirror",
      "item_zh": "Conference Board信心、Redbook、ICSC/UBS、ABC消费者舒适度、滞后的OECD消费者信心镜像",
      "status_en": "Vendor-controlled, not yet mapped to a reproducible public endpoint, or stale in the public mirror. University of Michigan sentiment remains charted as the durable public confidence gauge; retail sales and real PCE now include both YoY and MoM public FRED-derived momentum, while the Weekly Economic Index is charted as a high-frequency activity composite.",
      "status_zh": "供应商控制、尚未映射到可复跑公开endpoint，或公开镜像已滞后。密歇根消费者信心继续作为稳定公开信心指标绘图；零售销售和实际PCE现在同时提供由FRED公开序列派生的同比与环比动能，周度经济指数作为高频活动综合指标绘图。"
    },
    {
      "section": "housing",
      "item_en": "Pending Home Sales Index, NAHB Housing Market Index, mortgage applications",
      "item_zh": "待完成房屋销售指数、NAHB住房市场指数、按揭申请",
      "status_en": "Still not validated as license-safe public chart data. Public supply, price, stress, and listing-market gauges are charted, including Realtor.com active listings, pending listings, their YoY growth rates, and median days on market via FRED.",
      "status_zh": "仍未验证为授权安全公开图表数据。公开库存、价格、压力和挂牌市场指标已绘图，包括通过FRED接入的Realtor.com活跃挂牌、待完成挂牌、对应同比增速和挂牌中位天数。"
    },
    {
      "section": "external",
      "item_en": "Detailed Treasury International Capital System flows",
      "item_zh": "TIC详细资本流",
      "status_en": "Core TIC Treasury transactions and holdings are now charted via FRED; deeper country/security tables still need a Treasury TIC adapter if required.",
      "status_zh": "核心TIC国债交易与持有量已通过FRED绘图；如需更深国家/证券表，仍需要财政部TIC adapter。"
    },
    {
      "section": "employment",
      "item_en": "Manpower, Challenger layoffs, Monster/help-wanted indexes; BED API quota fallback",
      "item_zh": "Manpower、Challenger裁员、Monster/Help-wanted指数；BED API额度fallback",
      "status_en": "ADP private payrolls are charted from FRED. BLS BED gross job gains/losses use the public BLS API first and fall back to a checked-in last-good official cache when anonymous BLS quota is exhausted. Manpower, Challenger, and proprietary help-wanted sources remain vendor/licensing gaps.",
      "status_zh": "ADP私营就业已通过FRED绘图。BLS BED总就业创造/损失优先使用BLS公开API；当匿名BLS额度耗尽时，回退到已入库的最近一次官方成功缓存。Manpower、Challenger和专有Help-wanted来源仍属于供应商/授权缺口。"
    },
    {
      "section": "fed_policy",
      "item_en": "FOMC statement language, minutes, transcripts, projections, and future Treasury auction calendar",
      "item_zh": "FOMC声明措辞、纪要、会议记录、预测与未来国债拍卖日历",
      "status_en": "Completed Treasury auction quantities and bid-to-cover are now charted from FiscalData; text and future-calendar sources require separate NLP/calendar adapters.",
      "status_zh": "已完成国债拍卖规模和覆盖倍数已从FiscalData绘图；文本和未来日历数据需要单独NLP/日历adapter。"
    }
