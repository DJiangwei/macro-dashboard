  "data_gaps_detail": [
    {
      "section": "prices_costs",
      "item_en": "Core CPI excluding food and energy, and the services/goods split",
      "item_zh": "剔除食品与能源的核心CPI，以及服务/商品拆分",
      "status_en": "Stats SA publishes core CPI in its P0141 release as PDF and Excel without a documented stable API; the IMF CPI dataset carries no COICOP breakdown for South Africa.",
      "status_zh": "南非统计局在P0141发布中以PDF与Excel形式公布核心CPI，无有文档的稳定API；IMF CPI数据集不含南非的COICOP分项。"
    },
    {
      "section": "labour_wages",
      "item_en": "Expanded unemployment rate, vacancies, and earnings",
      "item_zh": "扩大口径失业率、职位空缺与薪酬",
      "status_en": "The expanded QLFS definition and the Quarterly Employment Statistics earnings series are published as Stats SA releases without a validated machine-readable endpoint.",
      "status_zh": "扩大口径QLFS定义与季度就业统计薪酬序列以南非统计局发布物形式公布，尚无经验证的机读接口。"
    },
    {
      "section": "production_cycle",
      "item_en": "Total industry production, mining production, and the BER/PMI business surveys",
      "item_zh": "工业总体生产、采矿业生产以及BER/PMI企业调查",
      "status_en": "No monthly total-industry or mining index validated on a key-free public endpoint; BER business confidence and the Absa PMI are vendor-controlled.",
      "status_zh": "尚未在无密钥公开接口上验证月度工业总体或采矿业指数；BER企业信心与Absa PMI由供应商控制。"
    },
    {
      "section": "monetary_financial",
      "item_en": "FTSE/JSE All Share index and equity valuation",
      "item_zh": "富时/约翰内斯堡全股指数与股票估值",
      "status_en": "JSE index levels are licensed through the exchange and its data vendors; no redistributable public series validated.",
      "status_zh": "JSE指数水平通过交易所及其数据供应商授权；尚未验证可再分发的公开序列。"
    },
    {
      "section": "monetary_financial",
      "item_en": "Eskom load-shedding stages and electricity availability factor",
      "item_zh": "Eskom限电等级与发电可用率",
      "status_en": "Published through Eskom's data portal and dashboards without a documented stable API contract; this is the single largest South Africa-specific supply-side variable still missing.",
      "status_zh": "通过Eskom数据门户与看板发布，无有文档的稳定API契约；这是南非特有供给侧变量中仍缺失的最重要一项。"
    },
    {
      "section": "external_fx",
      "item_en": "Gross reserves, capital-flow detail, and sovereign risk spread",
      "item_zh": "总储备、资本流动明细与主权风险利差",
      "status_en": "SARB's reserves and BoP detail are in the Quarterly Bulletin series set, which the public web API does not expose; CDS and EMBI spreads are vendor-controlled.",
      "status_zh": "SARB的储备与国际收支明细位于季度公报序列集，公开Web API未暴露；CDS与EMBI利差由供应商控制。"
    },
    {
      "section": "fiscal_sovereign",
      "item_en": "National Treasury monthly revenue and expenditure execution",
      "item_zh": "国库月度收支执行",
      "status_en": "Section 32 monthly statements are published as PDF and Excel attachments without a stable programmatic endpoint.",
      "status_zh": "第32条月度报表以PDF与Excel附件形式发布，无稳定的程序化接口。"
    }
