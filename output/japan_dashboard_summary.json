    {
      "section": "prices_costs",
      "item_en": "CPI by COICOP division (food, housing, transport, and the other CP01-CP12 categories)",
      "item_zh": "CPI的COICOP大类分项（食品、住房、交通等CP01-CP12类别）",
      "status_en": "OECD's Japan COICOP-division CPI mirror was discontinued after June 2021, and the IMF CPI dataset declares Japan's COICOP division keys (CP01-CP12) but returns them with no observations. The Statistics Bureau's e-Stat table carries these divisions too, but they are not yet wired here; only the goods/services split is chartable so far.",
      "status_zh": "OECD日本COICOP大类CPI镜像在2021年6月后停更，IMF CPI数据集虽声明了日本的COICOP大类键（CP01-CP12），但返回值为空。总务省统计局e-Stat表中也含这些大类，但尚未接入本页；目前仅商品/服务拆分可绘图。"
    },
    {
      "section": "labour_wages",
      "item_en": "Job-to-applicant ratio and shunto wage settlements",
      "item_zh": "有效求人倍率与春斗工资谈判结果",
      "status_en": "MHLW job-openings statistics require e-Stat credentials; shunto outcomes are compiled by Rengo and are not redistributable as a public series.",
      "status_zh": "厚生劳动省求人统计需e-Stat凭证；春斗结果由连合汇编，不可作为公开序列再分发。"
    },
    {
      "section": "consumption_retail",
      "item_en": "Household consumption expenditure and consumer confidence",
      "item_zh": "家庭消费支出与消费者信心",
      "status_en": "The FRED/OECD household consumption mirror stops in 2023Q3 and the OECD Japan consumer confidence mirror stops in January 2024; no replacement key-free endpoint validated.",
      "status_zh": "FRED/OECD家庭消费镜像止于2023年三季度，OECD日本消费者信心镜像止于2024年1月；尚未验证替代的无密钥接口。"
    },
    {
      "section": "housing_property",
      "item_en": "Housing starts and mortgage rates",
      "item_zh": "住宅开工与按揭利率",
      "status_en": "MLIT construction starts require e-Stat credentials; Japanese mortgage rates are posted per-bank rather than as an official aggregate series.",
      "status_zh": "国土交通省开工统计需e-Stat凭证；日本按揭利率由各行分别公布，无官方合计序列。"
    },
    {
      "section": "monetary_financial",
      "item_en": "BoJ balance sheet, ETF holdings, and financial conditions index",
      "item_zh": "日银资产负债表、ETF持仓与金融条件指数",
      "status_en": "BoJ balance-sheet accounts are published as flat files without a documented stable API; composite financial-conditions indices are vendor-proprietary.",
      "status_zh": "日银资产负债表以平面文件发布，无有文档的稳定API；综合金融条件指数为供应商专有。"
    },
    {
      "section": "prices_costs",
      "item_en": "Inflation expectations (Tankan price outlook, breakevens)",
      "item_zh": "通胀预期（短观价格预期、盈亏平衡通胀）",
      "status_en": "Tankan price expectations are BoJ-proprietary in redistributable form and the JGBi breakeven series has no validated key-free public endpoint.",
      "status_zh": "短观价格预期的可再分发形式属日银专有，物价联动国债盈亏平衡序列亦无经验证的无密钥公开接口。"
    }
